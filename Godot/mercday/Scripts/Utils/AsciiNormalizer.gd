const REPORT_ARG: String = "--tsv-report"

static var _silent_count: int = 0
static var _report_flag: int = -1


static func normalize(text: String, source: String, row: int) -> String:
	var count: int = text.length()
	var needs_work := false
	for i: int in range(count):
		if text.unicode_at(i) > 127:
			needs_work = true
			break
	if not needs_work:
		return text
	var out := ""
	for i: int in range(count):
		var cp: int = text.unicode_at(i)
		if cp < 128:
			out += text[i]
		elif REPLACEMENTS.has(cp):
			out += REPLACEMENTS[cp] as String
			_silent_count += 1
		else:
			out += " "
			push_warning("DataManager: %s row %d: U+%04X has no ASCII equivalent, replaced with space" % [
				source, row, cp])
	return out


static func reset_count() -> void:
	_silent_count = 0


static func report_enabled() -> bool:
	if _report_flag < 0:
		_report_flag = 1 if OS.get_cmdline_user_args().has(REPORT_ARG) else 0
	return _report_flag == 1


static func report_file(source: String) -> void:
	if _silent_count > 0 and report_enabled():
		print("DataManager: %s: %d non-ASCII characters normalized" % [source, _silent_count])
