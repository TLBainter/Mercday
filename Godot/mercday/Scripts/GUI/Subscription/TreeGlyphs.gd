static var _cache: Dictionary = {}


static func has_map(id: String) -> bool:
	return MAPS.has(id)


static func png_path(id: String) -> String:
	if id == "base":
		return ICON_DIR + BASE_PNG
	return ICON_DIR + "customize_" + id + "_12x12.png"


#The block icon: the authored PNG recoloured when there is one, else the built map.
static func icon(id: String, tint: Color) -> ImageTexture:
	var key: String = id + "|" + tint.to_html(false)
	if _cache.has(key):
		return _cache[key]
	var tex: ImageTexture = _from_png(png_path(id), tint)
	if tex == null:
		var map: Array = MAPS.get(id, []) as Array
		if map.is_empty():
			map = MAPS["base"] as Array
		tex = _from_map(map, tint)
	_cache[key] = tex
	return tex


#The My Mercday logo of the Base block, tinted by the progress of the whole tree.
static func logo(tint: Color) -> ImageTexture:
	var key: String = "logo|" + tint.to_html(false)
	if _cache.has(key):
		return _cache[key]
	var tex: ImageTexture = _from_png(png_path("base"), tint)
	if tex == null:
		tex = _from_map(LOGO, tint)
	_cache[key] = tex
	return tex


static func _from_png(path: String, tint: Color) -> ImageTexture:
	if not ResourceLoader.exists(path):
		return null
	var res: Resource = load(path)
	if not (res is Texture2D):
		return null
	var src: Image = (res as Texture2D).get_image()
	if src == null:
		return null
	var img: Image = src.duplicate() as Image
	img.convert(Image.FORMAT_RGBA8)
	for y: int in range(img.get_height()):
		for x: int in range(img.get_width()):
			var a: float = img.get_pixel(x, y).a
			if a > 0.0:
				img.set_pixel(x, y, Color(tint.r, tint.g, tint.b, a))
	return ImageTexture.create_from_image(img)


static func _from_map(map: Array, tint: Color) -> ImageTexture:
	var rows: int = map.size()
	var cols: int = String(map[0]).length() if rows > 0 else 0
	if rows <= 0 or cols <= 0:
		return null
	var img: Image = Image.create_empty(cols, rows, false, Image.FORMAT_RGBA8)
	img.fill(Color(0.0, 0.0, 0.0, 0.0))
	for y: int in range(rows):
		var line: String = String(map[y])
		for x: int in range(mini(cols, line.length())):
			if line[x] != ".":
				img.set_pixel(x, y, tint)
	return ImageTexture.create_from_image(img)
