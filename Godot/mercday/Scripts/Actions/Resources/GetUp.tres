[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://Scripts/Resources/ActionData.gd" id="ActionData"]
[ext_resource type="Script" path="res://Scripts/Resources/DecisionData.gd" id="DecisionData"]
[ext_resource type="Script" path="res://Scripts/Decisions/ActiveStateFacet.gd" id="ActiveStateFacet"]
[ext_resource type="Script" path="res://Scripts/Decisions/HpRatioFacet.gd" id="HpRatioFacet"]
[ext_resource type="Script" path="res://Scripts/Decisions/EnemyDistanceFacet.gd" id="EnemyDistanceFacet"]

[sub_resource type="Resource" id="facet_req"]
script = ExtResource("ActiveStateFacet")
is_required = true
state_name = "Deposed"
present_is_high = true

[sub_resource type="Resource" id="facet_hp"]
script = ExtResource("HpRatioFacet")
weight = 1.0
threshold = 0.25
below_is_high = true

[sub_resource type="Resource" id="facet_dist"]
script = ExtResource("EnemyDistanceFacet")
weight = 1.0
max_dist = 1.0
close_is_high = false

[sub_resource type="Resource" id="decision"]
script = ExtResource("DecisionData")
facets = [SubResource("facet_req"), SubResource("facet_hp"), SubResource("facet_dist")]
threshold = 0.3

[resource]
script = ExtResource("ActionData")
action_name = "get_up"
ap_cost = 2
priority = 20
decision = SubResource("decision")
