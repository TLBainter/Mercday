[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://Scripts/Actions/ClimbAction.gd" id="ClimbAction"]
[ext_resource type="Script" path="res://Scripts/Resources/DecisionData.gd" id="DecisionData"]
[ext_resource type="Script" path="res://Scripts/Decisions/CanStartClimbFacet.gd" id="CanStartClimbFacet"]
[ext_resource type="Script" path="res://Scripts/Decisions/ActiveStateFacet.gd" id="ActiveStateFacet"]
[ext_resource type="Script" path="res://Scripts/Decisions/HasClimbStatFacet.gd" id="HasClimbStatFacet"]
[ext_resource type="Script" path="res://Scripts/Decisions/EnemyDistanceFacet.gd" id="EnemyDistanceFacet"]

[sub_resource type="Resource" id="facet_can_start"]
script = ExtResource("CanStartClimbFacet")
is_required = true

[sub_resource type="Resource" id="facet_not_climbing"]
script = ExtResource("ActiveStateFacet")
is_required = true
state_name = "Climbing"
present_is_high = false

[sub_resource type="Resource" id="facet_has_stat"]
script = ExtResource("HasClimbStatFacet")
is_required = false
weight = 1.0

[sub_resource type="Resource" id="facet_no_melee_enemy"]
script = ExtResource("EnemyDistanceFacet")
is_required = false
weight = 2.0
max_dist = 1.0
close_is_high = false

[sub_resource type="Resource" id="decision"]
script = ExtResource("DecisionData")
facets = [SubResource("facet_can_start"), SubResource("facet_not_climbing"), SubResource("facet_has_stat"), SubResource("facet_no_melee_enemy")]
threshold = 0.50

[resource]
script = ExtResource("ClimbAction")
action_name = "Initiate Climb"
ap_cost = 2
ap_cost_mode = "move_base"
priority = 50
execution_type = "climb"
target_mode = "none"
decision = SubResource("decision")
