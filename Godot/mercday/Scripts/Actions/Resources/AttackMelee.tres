[sub_resource type="Resource" id="facet_weapon"]
script = ExtResource("WeaponTypeFacet")
is_required = true

[sub_resource type="Resource" id="facet_targets"]
script = ExtResource("CtxFlagFacet")
key = "valid_targets"
is_required = true

[sub_resource type="Resource" id="facet_misfire"]
script = ExtResource("NotMisfiredFacet")
is_required = true

[sub_resource type="Resource" id="facet_reach"]
script = ExtResource("MeleeReachFacet")
is_required = true

[sub_resource type="Resource" id="facet_fitness"]
script = ExtResource("WeaponFitnessFacet")
invert = true

[sub_resource type="Resource" id="decision"]
script = ExtResource("DecisionData")
facets = Array[ExtResource("1_rhf7c")]([SubResource("facet_weapon"), SubResource("facet_targets"), SubResource("facet_misfire"), SubResource("facet_reach"), SubResource("facet_fitness")])
threshold = 0.0

[resource]
script = ExtResource("ActionData")
action_name = "Attack"
ap_cost = 3
ap_cost_mode = "attack_base"
priority = 45
execution_type = "attack"
target_mode = "current_or_best"
decision = SubResource("decision")
