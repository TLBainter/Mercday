[sub_resource type="Resource" id="facet_approaching"]
script = ExtResource("EnemyApproachingFacet")
is_required = true

[sub_resource type="Resource" id="facet_move"]
script = ExtResource("CtxFlagFacet")
key = "movement_blocked"
is_required = true
invert = true

[sub_resource type="Resource" id="facet_grapple"]
script = ExtResource("AnyStateFacet")
is_required = true
invert = true

[sub_resource type="Resource" id="facet_hp"]
script = ExtResource("HpRatioFacet")
invert = true

[sub_resource type="Resource" id="facet_range"]
script = ExtResource("NotAtOptimalRangeFacet")
weight = 2.0

[sub_resource type="Resource" id="facet_readiness"]
script = ExtResource("CombatReadinessFacet")
weight = 1.5

[sub_resource type="Resource" id="facet_exits"]
script = ExtResource("OpenExitsFacet")
weight = 0.5

[sub_resource type="Resource" id="facet_not_aimed"]
