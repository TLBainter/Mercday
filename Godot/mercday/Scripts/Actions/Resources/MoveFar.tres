threshold = 0.4

[resource]
script = ExtResource("ActionData")
action_name = "Move Far"
ap_cost = 2
ap_cost_mode = "move_base"
priority = 50
execution_type = "move"
target_mode = "nearest_enemy"
snap_require = {
"movement_blocked": false
}
