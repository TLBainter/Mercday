[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://Scripts/Resources/ActionData.gd" id="ActionData"]
[ext_resource type="Script" path="res://Scripts/Resources/DecisionData.gd" id="DecisionData"]
[ext_resource type="Script" path="res://Scripts/Decisions/MovementNotBlockedFacet.gd" id="MovementNotBlocked"]
[ext_resource type="Script" path="res://Scripts/Decisions/ActiveStateFacet.gd" id="ActiveStateFacet"]
[ext_resource type="Script" path="res://Scripts/Decisions/HpRatioFacet.gd" id="HpRatioFacet"]
[ext_resource type="Script" path="res://Scripts/Decisions/NotAtOptimalRangeFacet.gd" id="NotAtOptimalRangeFacet"]
[ext_resource type="Script" path="res://Scripts/Decisions/EnemyApproachingFacet.gd" id="EnemyApproachingFacet"]
[ext_resource type="Script" path="res://Scripts/Decisions/CombatReadinessFacet.gd" id="CombatReadinessFacet"]
[ext_resource type="Script" path="res://Scripts/Decisions/OpenExitsFacet.gd" id="OpenExitsFacet"]
[ext_resource type="Script" path="res://Scripts/Decisions/AimActiveFacet.gd" id="AimActiveFacet"]
[ext_resource type="Script" path="res://Scripts/Decisions/RangedRetreatViabilityFacet.gd" id="RangedRetreatViabilityFacet"]

[sub_resource type="Resource" id="facet_approaching"]
script = ExtResource("EnemyApproachingFacet")
is_required = true

[sub_resource type="Resource" id="facet_move"]
script = ExtResource("MovementNotBlocked")
is_required = true

[sub_resource type="Resource" id="facet_grapple"]
script = ExtResource("ActiveStateFacet")
is_required = true
state_name = "Grappled"
present_is_high = false

[sub_resource type="Resource" id="facet_hp"]
script = ExtResource("HpRatioFacet")
weight = 1.0
below_is_high = true

[sub_resource type="Resource" id="facet_range"]
script = ExtResource("NotAtOptimalRangeFacet")
weight = 2.0

[sub_resource type="Resource" id="facet_readiness"]
script = ExtResource("CombatReadinessFacet")
weight = 1.5
invert = false

[sub_resource type="Resource" id="facet_exits"]
script = ExtResource("OpenExitsFacet")
weight = 0.5

[sub_resource type="Resource" id="facet_not_aimed"]
script = ExtResource("AimActiveFacet")
aimed_is_high = false
weight = 0.75

[sub_resource type="Resource" id="facet_weapon"]
script = ExtResource("RangedRetreatViabilityFacet")
weight = 4.0

[sub_resource type="Resource" id="decision"]
script = ExtResource("DecisionData")
facets = [SubResource("facet_approaching"), SubResource("facet_move"), SubResource("facet_grapple"), SubResource("facet_hp"), SubResource("facet_range"), SubResource("facet_readiness"), SubResource("facet_exits"), SubResource("facet_not_aimed"), SubResource("facet_weapon")]
threshold = 0.4

[resource]
script = ExtResource("ActionData")
action_name = "Move Far"
ap_cost = 2
ap_cost_mode = "move_base"
priority = 50
execution_type = "move"
target_mode = "nearest_enemy"
snap_require = {"movement_blocked": false}
decision = SubResource("decision")
