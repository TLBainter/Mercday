[sub_resource type="Resource" id="facet_enemies_exist"]
script = ExtResource("CtxFlagFacet")
key = "enemies"
is_required = true

[sub_resource type="Resource" id="facet_no_targets"]
script = ExtResource("NoClearShot")

[sub_resource type="Resource" id="facet_move"]
script = ExtResource("CtxFlagFacet")
key = "movement_blocked"
is_required = true
invert = true

[sub_resource type="Resource" id="facet_grapple"]
script = ExtResource("AnyStateFacet")
is_required = true
invert = true

[sub_resource type="Resource" id="facet_terrified"]
script = ExtResource("AnyStateFacet")
is_required = true
invert = true

[sub_resource type="Resource" id="facet_preferred"]
script = ExtResource("MeleePreferred")

[sub_resource type="Resource" id="facet_dist"]
script = ExtResource("EnemyDistanceFacet")
close_is_high = false

[sub_resource type="Resource" id="facet_readiness"]
script = ExtResource("CombatReadinessFacet")
invert = true

[sub_resource type="Resource" id="facet_last_seen"]
script = ExtResource("LastSeenAvailable")

[sub_resource type="Resource" id="facet_hp_risk"]
script = ExtResource("HpRatioFacet")
weight = 0.5

[sub_resource type="Resource" id="facet_threat_risk"]
script = ExtResource("RangedThreatFacet")
weight = 0.5
invert = true

[sub_resource type="Resource" id="facet_not_aimed"]
script = ExtResource("AimActiveFacet")
weight = 0.75
invert = true

[sub_resource type="Resource" id="facet_idle"]
script = ExtResource("CombatIdleFacet")
weight = 0.5
invert = true

[sub_resource type="Resource" id="facet_poor_shot"]
script = ExtResource("PoorShotQuality")

[sub_resource type="Resource" id="facet_can_see"]
script = ExtResource("CanSeeTarget")

[sub_resource type="Resource" id="decision"]
script = ExtResource("DecisionData")
facets = Array[ExtResource("1_ceqg4")]([SubResource("facet_enemies_exist"), SubResource("facet_no_targets"), SubResource("facet_move"), SubResource("facet_grapple"), SubResource("facet_terrified"), SubResource("facet_preferred"), SubResource("facet_dist"), SubResource("facet_readiness"), SubResource("facet_last_seen"), SubResource("facet_hp_risk"), SubResource("facet_threat_risk"), SubResource("facet_not_aimed"), SubResource("facet_idle"), SubResource("facet_poor_shot"), SubResource("facet_can_see")])

[resource]
script = ExtResource("MoveCloseAction")
action_name = "Move Close"
ap_cost = 2
ap_cost_mode = "move_base"
priority = 50
execution_type = "move"
target_mode = "nearest_enemy"
snap_require = {
"movement_blocked": false
}
decision = SubResource("decision")
