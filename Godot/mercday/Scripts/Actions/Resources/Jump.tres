[ext_resource type="Script" uid="uid://cc0v77wme2mqr" path="res://Scripts/Actions/JumpAction.gd" id="JumpAction"]

[sub_resource type="Resource" id="facet_enemies"]
script = ExtResource("CtxFlagFacet")
key = "enemies"
is_required = true

[sub_resource type="Resource" id="facet_grapple"]
script = ExtResource("AnyStateFacet")
is_required = true
invert = true

[sub_resource type="Resource" id="facet_terrified"]
script = ExtResource("AnyStateFacet")
is_required = true
invert = true

[sub_resource type="Resource" id="facet_deposed"]
script = ExtResource("AnyStateFacet")
is_required = true
invert = true

[sub_resource type="Resource" id="facet_no_attack_target"]
script = ExtResource("CtxFlagFacet")
key = "valid_targets"
is_required = true
invert = true

[sub_resource type="Resource" id="decision"]
script = ExtResource("DecisionData")
facets = Array[ExtResource("1_p66n5")]([SubResource("facet_enemies"), SubResource("facet_grapple"), SubResource("facet_terrified"), SubResource("facet_deposed"), SubResource("facet_no_attack_target")])

[resource]
script = ExtResource("JumpAction")
action_name = "Jump"
ap_cost = 2
ap_cost_mode = "move_base"
priority = 50
execution_type = "jump"
target_mode = "nearest_enemy"
