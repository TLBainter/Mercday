[sub_resource type="Resource" id="facet_weapon"]
script = ExtResource("WeaponTypeFacet")
require_ranged = true
is_required = true

[sub_resource type="Resource" id="facet_ammo"]
script = ExtResource("AmmoStatusFacet")
is_required = true

[sub_resource type="Resource" id="facet_targets"]
script = ExtResource("CtxFlagFacet")
key = "valid_targets"
is_required = true

[sub_resource type="Resource" id="facet_aimed"]
script = ExtResource("AimActiveFacet")
is_required = true
invert = true

[sub_resource type="Resource" id="facet_misfire"]
script = ExtResource("NotMisfiredFacet")
is_required = true

[sub_resource type="Resource" id="facet_hit_chance"]
script = ExtResource("EffectiveHitChanceFacet")
is_required = true

[sub_resource type="Resource" id="facet_payoff"]
script = ExtResource("AimPayoffFacet")
is_required = true

[sub_resource type="Resource" id="decision"]
script = ExtResource("DecisionData")
facets = Array[ExtResource("1_oj3bs")]([SubResource("facet_weapon"), SubResource("facet_ammo"), SubResource("facet_targets"), SubResource("facet_aimed"), SubResource("facet_misfire"), SubResource("facet_hit_chance"), SubResource("facet_payoff")])

[resource]
script = ExtResource("ActionData")
action_name = "aim"
ap_cost = 2
priority = 60
snap_require = {
"weapon_is_ranged": true
}
decision = SubResource("decision")
