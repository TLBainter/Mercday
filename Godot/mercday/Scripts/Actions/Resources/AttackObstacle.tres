[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://Scripts/Resources/ActionData.gd" id="ActionData"]
[ext_resource type="Script" path="res://Scripts/Resources/DecisionData.gd" id="DecisionData"]
[ext_resource type="Script" path="res://Scripts/Decisions/ObstacleBlockingFacet.gd" id="ObstacleBlockingFacet"]
[ext_resource type="Script" path="res://Scripts/Decisions/WeaponTypeFacet.gd" id="WeaponTypeFacet"]

[sub_resource type="Resource" id="facet_blocked"]
script = ExtResource("ObstacleBlockingFacet")
is_required = true

[sub_resource type="Resource" id="facet_weapon"]
script = ExtResource("WeaponTypeFacet")
is_required = true
require_ranged = false
require_drawn = true

[sub_resource type="Resource" id="decision"]
script = ExtResource("DecisionData")
facets = [SubResource("facet_blocked"), SubResource("facet_weapon")]
threshold = 0.5

[resource]
script = ExtResource("ActionData")
action_name = "attack_obstacle"
ap_cost = 3
ap_cost_mode = "attack_base"
priority = 75
execution_type = "special"
target_mode = "none"
decision = SubResource("decision")
