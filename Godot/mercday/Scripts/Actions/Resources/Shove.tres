[gd_resource type="Resource" script_class="ActionData" format=3 uid="uid://b8ox0b7625abi"]

[ext_resource type="Script" uid="uid://rmd4uedu2bvv" path="res://Scripts/Resources/DecisionFacet.gd" id="1_x2cnw"]
[ext_resource type="Script" uid="uid://dqwnhh4oorllj" path="res://Scripts/Resources/ActionData.gd" id="ActionData"]
[ext_resource type="Script" uid="uid://dbowr7u5ueeyf" path="res://Scripts/Resources/DecisionData.gd" id="DecisionData"]
[ext_resource type="Script" uid="uid://cn12eo1r34mrv" path="res://Scripts/Decisions/EnemyDistanceFacet.gd" id="EnemyDistanceFacet"]
[ext_resource type="Script" uid="uid://b8ddmc8tnn2xm" path="res://Scripts/Decisions/ShoveFeasibilityFacet.gd" id="ShoveFeasibilityFacet"]
[ext_resource type="Script" uid="uid://bndcbyh4xbhio" path="res://Scripts/Decisions/ShoveOutcomeFacet.gd" id="ShoveOutcomeFacet"]

[sub_resource type="Resource" id="facet_dist_req"]
script = ExtResource("EnemyDistanceFacet")
is_required = true

[sub_resource type="Resource" id="facet_feasibility"]
script = ExtResource("ShoveFeasibilityFacet")
is_required = true

[sub_resource type="Resource" id="facet_outcome"]
script = ExtResource("ShoveOutcomeFacet")

[sub_resource type="Resource" id="decision"]
script = ExtResource("DecisionData")
facets = Array[ExtResource("1_x2cnw")]([SubResource("facet_dist_req"), SubResource("facet_feasibility"), SubResource("facet_outcome")])
threshold = 0.4

[resource]
script = ExtResource("ActionData")
action_name = "shove"
ap_cost = 3
priority = 65
target_mode = "current_or_best"
snap_require = {
"enemy_adjacent": true
}
decision = SubResource("decision")
